# Copy to ~/.config/voxen/discord-206-smoke.env (chmod 600). Never commit real values.
#
# Host: BenSpark — source before scripts/discord_hybrid_206_smoke.sh

CP_BASE_URL=http://192.168.0.206:3010

# Same bearer as adapter + CP (EMBER_DISCORD_SERVICE_BEARER on both sides)
EMBER_DISCORD_SERVICE_BEARER=

# Public adapter URL (edge vhost or LAN publish), e.g.:
# ADAPTER_PUBLIC_URL=https://discord-dev.doublesecretprobationstudios.com
# ADAPTER_PUBLIC_URL=http://192.168.0.206:8787
ADAPTER_PUBLIC_URL=

# For adapter signed checks: production DISCORD_PUBLIC_KEY from Discord Developer Portal.
# Do NOT use the repo test key against production adapter.
DISCORD_PUBLIC_KEY=

# Optional: guild with active binding on .206 (else fan-query about returns 404)
SMOKE_GUILD_ID=

# Set 1 to curl adapter internal metrics via SSH on .206 (docker)
RUN_SSH_CHECKS=0
SSH_HOST=digitize@192.168.0.206
ADAPTER_CONTAINER=ember-discord-adapter
