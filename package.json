{
  "name": "ember-discord-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Ember Discord HTTP Interactions adapter",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "register": "tsx scripts/register.ts"
  },
  "dependencies": {
    "discord-interactions": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tweetnacl": "^1.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
